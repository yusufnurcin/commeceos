{
  "name": "@commerce-os/gateway-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "platform:bootstrap": "tsx scripts/platform-bootstrap.ts",
    "platform:bootstrap:direct": "tsx scripts/platform-bootstrap.ts --direct",
    "demo:seed": "tsx scripts/demo-command.ts seed",
    "demo:cleanup": "tsx scripts/demo-command.ts cleanup",
    "demo:status": "tsx scripts/demo-command.ts status",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@commerce-os/analytics-core": "workspace:*",
    "@commerce-os/auth-core": "workspace:*",
    "@commerce-os/commerce-core": "workspace:*",
    "@commerce-os/sync-core": "workspace:*",
    "@commerce-os/tenant-core": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2"
  }
}
