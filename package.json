{
  "name": "commerce-os-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "platform:bootstrap": "pnpm --filter @commerce-os/gateway-api platform:bootstrap",
    "env:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/env/validate-foundation-env.ps1 -EnvFile ./infra/env/local.example.env",
    "health:infra": "powershell -NoProfile -ExecutionPolicy Bypass -File ./infra/healthchecks/check-foundation.ps1",
    "docker:config": "docker compose --env-file ./infra/env/local.example.env config",
    "docker:up": "docker compose --env-file ./infra/env/local.example.env up -d --build",
    "docker:down": "docker compose --env-file ./infra/env/local.example.env down",
    "docker:logs": "docker compose --env-file ./infra/env/local.example.env logs --tail=200"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "pnpm": "9.15.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
